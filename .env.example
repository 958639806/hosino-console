# Copy to a secure, untracked file with restrictive permissions.
# node --env-file=/secure/path/hosino-console.env server.mjs
# Generate your own bcrypt password hash; never commit the password or hash.
LOGIN_HASH=
PORT=18890
OPENCLAW_CONFIG=/home/ubuntu/.openclaw/openclaw.json
GATEWAY_URL=wss://127.0.0.1:18789
GATEWAY_CERT=/secure/path/gateway-cert.pem
# Optional SHA-256 fingerprint override. If omitted, use the certificate fingerprint.
# GATEWAY_FP=
OPENCLAW_WORKSPACE=/home/ubuntu/.openclaw/workspace
QDRANT_URL=http://127.0.0.1:6333
MEM_COLLECTION=mem0_full_timestamped_20260926
QQ_SEND_ENABLED=0
# QQ recall switch. Existing snapshot default is enabled; no message is recalled automatically.
# QQ_RECALL_ENABLED=1
# Quiet window uses Asia/Singapore time; 'off' disables it. See API.md for exact coverage.
# HOSINO_QUIET_WINDOW=21:55-22:10
# Existing model direct checks only read the specified variables/store; never log their values.
# OPENCLAW_HOME=/home/ubuntu/.openclaw
# PING_DIRECT_ENV_FILE=/home/ubuntu/.openclaw/.env
# PING_DIRECT_SECRET_DB=/home/ubuntu/.openclaw/state/openclaw.sqlite
# MODEL_PING_DIRECT_TIMEOUT_MS=20000
