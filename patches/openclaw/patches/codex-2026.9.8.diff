@@ -0,0 +1,23 @@
+// CODEX-LATENCY456-PATCH v1
+import { createHash } from 'node:crypto';
+
+const LABELS = new Set(['history-read', 'workspace-bootstrap', 'input-attachments', 'prompt-build-hooks']);
+
+/** Observe four existing awaited preparation operations without retaining their inputs. */
+export function createCodexPreparationLeafTimer({ enabled, runId, emit, now = () => performance.now() }) {
+  if (enabled !== true) return (_label, run) => run();
+  const runHash = createHash('sha256').update('openclaw:codex:preparation-leaf:v1\0').update(String(runId ?? '')).digest('hex').slice(0, 16);
+  return async (label, run) => {
+    let started;
+    try { started = now(); } catch { return run(); }
+    try {
+      return await run();
+    } finally {
+      // Diagnostics must never replace an operation's value or thrown error.
+      try {
+        const ms = Math.max(0, Math.round((now() - started) * 1000) / 1000);
+        if (LABELS.has(label) && Number.isFinite(ms)) emit({ runHash, label, ms });
+      } catch {}
+    }
+  };
+}
