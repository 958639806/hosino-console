+// QQ-LATENCY-TRACE native/proxy metadata v1. Diagnostics never own execution.
+import { qqLatencyTraceHash, qqLatencyTraceNow } from './qq-latency-trace.mjs';
+
+const HASH = /^[a-f0-9]{24}$/;
+const GROUPS = new Map([['agent:main:qqbot:group:__HS_GROUP_OLD_OPENID__', 'old'], ['agent:main:qqbot:group:__HS_GROUP_NEW_OPENID__', 'new']]);
+const SOURCE_CONTEXTS = new WeakMap();
+// A host capsule and a successful native turn/start response establish timing
