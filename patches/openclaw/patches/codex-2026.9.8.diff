+// QQ-MEMORY-PRIVACY-EPOCH v1. Caller must hold a live native-run authority; this module never reads chat bodies.
+import fs from 'node:fs';
+import path from 'node:path';
+import { createHash } from 'node:crypto';
+const digest = (value) => createHash('sha256').update(String(value)).digest('hex');
+const POLICY_EPOCH = 'mem0-conversation-scope-v4';
+function atomic(file, value, assertCurrent) {
+  assertCurrent(); fs.mkdirSync(path.dirname(file), { recursive: true, mode: 0o700 });
+  const temp = `${file}.${process.pid}.tmp`, fd = fs.openSync(temp, 'w', 0o600);
+  try { fs.writeFileSync(fd, JSON.stringify(value)); fs.fsyncSync(fd); } finally { fs.closeSync(fd); }
+  assertCurrent(); fs.renameSync(temp, file);
+  if (process.platform !== 'win32') { const dir=fs.openSync(path.dirname(file),'r'); try { fs.fsyncSync(dir); } finally { fs.closeSync(dir); } }
+}
+function read(file) { return fs.existsSync(file) ? JSON.parse(fs.readFileSync(file, 'utf8')) : undefined; }
+export async function prepareQQMemoryPrivacyEpoch({ params, binding, identity, bindingStore, assertCurrent, assertMayReplace, stateDir }) {
+  const sessionKey = String(params.sessionKey || '').trim().toLowerCase();
+  const entry = params.config?.plugins?.entries?.['openclaw-mem0'];
+  if (!/^agent:[^:]+:qqbot:group:[a-z0-9_-]+$/.test(sessionKey) || !entry || entry.enabled === false || entry.config?.mode !== 'open-source') return { binding };
+  if (!['user', 'heartbeat'].includes(params.trigger)) return { binding };
+  if (params.memoryPrivacyContextEngineActive === true) throw new Error('PRIVACY_EPOCH_CONTEXT_ENGINE_UNSUPPORTED');
+  if (typeof assertCurrent !== 'function' || typeof assertMayReplace !== 'function') throw new Error('PRIVACY_EPOCH_AUTHORITY_UNAVAILABLE');
+  const base = stateDir || path.join(process.env.OPENCLAW_STATE_DIR || path.join(process.env.HOME || '', '.openclaw'), 'state', 'mem0-runtime-v2', 'native-privacy-epochs');
+  const file = path.join(base, digest(sessionKey) + '.json');
+  const old = read(file);
+  if (old?.epoch === POLICY_EPOCH && old.state === 'complete' && (!binding?.threadId || !old.deniedThreadIds.includes(binding.threadId))) return { binding, epoch: old, file, needsCommit: false };
+  const denied = new Set(old?.deniedThreadIds || []);
+  if (!binding?.threadId) return { binding, file, needsCommit: true, epoch: { schema: 1, epoch: POLICY_EPOCH, state: 'pending', deniedThreadIds: [...denied] } };
+  assertMayReplace(binding, 'rotating pre-scope QQ native context', params.expectedSessionRuntimeOwnership);
+  const expectedThreadId = binding.threadId;
+  return await bindingStore.withLease(identity, async () => {
+    assertCurrent();
+    const current = bindingStore.read(identity);
+    if (current?.threadId !== expectedThreadId) throw new Error('PRIVACY_EPOCH_BINDING_CHANGED');
+    assertMayReplace(current, 'rotating pre-scope QQ native context', params.expectedSessionRuntimeOwnership);
+    denied.add(expectedThreadId);
+    const epoch = { schema: 1, epoch: POLICY_EPOCH, state: 'rotating', deniedThreadIds: [...denied], previousThreadIdHash: digest(expectedThreadId) };
+    atomic(file, epoch, assertCurrent);
+    const cleared = await bindingStore.mutate(identity, { kind: 'clear', threadId: expectedThreadId }, assertCurrent);
+    assertCurrent();
+    if (!cleared || bindingStore.read(identity)?.threadId) throw new Error('PRIVACY_EPOCH_CLEAR_NOT_CONFIRMED');
+    return { binding: undefined, file, epoch, needsCommit: true, previousThreadId: expectedThreadId };
+  });
+}
+export function commitQQMemoryPrivacyEpoch({ prepared, thread, identity, bindingStore, assertCurrent }) {
+  if (!prepared?.needsCommit) return;
+  assertCurrent();
+  if (thread?.lifecycle?.action !== 'started' || !thread.threadId || prepared.epoch.deniedThreadIds.includes(thread.threadId)) throw new Error('PRIVACY_EPOCH_REQUIRES_FRESH_THREAD');
+  if (bindingStore.read(identity)?.threadId !== thread.threadId) throw new Error('PRIVACY_EPOCH_NEW_BINDING_CHANGED');
+  atomic(prepared.file, { ...prepared.epoch, state: 'complete', completedThreadIdHash: digest(thread.threadId), completedAt: Date.now() }, assertCurrent);
+}
+
+// Render-time view only; original core transcript records are retained. Never use native thread/read/fork to rebuild.
+// Terminal assistant text is retained as conversation context; this module does not attest historical QQ delivery ACKs.
+// QQ-CHANNEL-SOURCE-CUSTODY v1. This is a rendered-history predicate, never an owner/tool grant.
+const QQ_CHANNEL_USER_KEY = /^channel-user:v1:[a-f0-9]{64}$/;
+function qqPrivacyExactString(value, max = 512) {
+  return typeof value === 'string' && value.length > 0 && value.length <= max && value === value.trim() && !/[\x00-\x1f]/.test(value) ? value : undefined;
+}
+function resolveQQPrivacySourceScope(scope) {
+  if (!scope || typeof scope !== 'object' || scope.channel !== 'qqbot') return;
+  const sessionKey = qqPrivacyExactString(scope.sessionKey);
+  const target = qqPrivacyExactString(scope.target);
+  const route = sessionKey?.match(/^agent:[^:]+:qqbot:group:([^:\s]+)$/i);
+  const delivery = target?.match(/^qqbot:group:([^:\s]+)$/i);
+  if (!route || !delivery || route[1].toLowerCase() !== delivery[1].toLowerCase()) return;
+  // The installed host normalizes an omitted account to DEFAULT_ACCOUNT_ID="default".
+  // Explicit IDs already come from the host's canonical run parameters; never coerce them.
+  const accountId = scope.accountId === undefined || scope.accountId === null || scope.accountId === '' ? 'default' : qqPrivacyExactString(scope.accountId, 128);
+  if (!accountId) return;
+  return { accountId, target };
+}
+export function isOriginalQQChannelUserMessage(message, sourceScope) {
+  try {
+    const scope = resolveQQPrivacySourceScope(sourceScope);
+    if (!scope || message?.role !== 'user' || typeof message.idempotencyKey !== 'string' || !QQ_CHANNEL_USER_KEY.test(message.idempotencyKey)) return false;
+    if (message.display === false || message.excludeFromContext === true || message.provenance?.kind && message.provenance.kind !== 'external_user') return false;
+    const metadata = message.__openclaw;
+    const transport = metadata?.transport;
+    const identity = metadata?.senderIdentity;
+    const senderId = qqPrivacyExactString(metadata?.senderId);
+    const messageId = qqPrivacyExactString(transport?.messageId, 2048);
+    const conversationRef = qqPrivacyExactString(transport?.conversationRef);
+    if (!senderId || !messageId || !conversationRef || transport.channel !== 'qqbot' || identity?.type !== 'observation' || identity.pluginId !== 'qqbot' || identity.id !== senderId || identity.accountId !== scope.accountId) return false;
+    // Same contract as the captured source-turn-id.ts: preserve target case in the digest.
+    // A later Codex mirror annotation does not replace this original channel-turn custody.
+    const digest = createHash('sha256').update(JSON.stringify(['qqbot', scope.accountId, scope.target, messageId])).digest('hex');
+    return message.idempotencyKey === `channel-user:v1:${digest}`;
+  } catch { return false; }
+}
+
+export function projectQQMemoryPrivacyHistory(messages, { isNativeMirror = () => false, sourceScope } = {}) {
+  const selected = [];
+  for (const message of messages) {
+    if (!message || typeof message !== 'object') continue;
+    if (message.role === 'user') {
+      const channelKey = typeof message.idempotencyKey === 'string' && message.idempotencyKey.startsWith('channel-user:');
+      const originalChannelUser = channelKey && isOriginalQQChannelUserMessage(message, sourceScope);
+      if (channelKey ? !originalChannelUser : isNativeMirror(message) || typeof message.idempotencyKey === 'string' && message.idempotencyKey.startsWith('codex-app-server:')) continue;
+      if (message.display === false || message.excludeFromContext === true || message.provenance?.kind && message.provenance.kind !== 'external_user') continue;
+      selected.push(message);
+    } else if (message.role === 'assistant') {
+      if (message.phase === 'commentary' || message.openclawAsyncDelivery || message.display === false || message.excludeFromContext === true) continue;
+      // Keep text-only terminal/public conversation content. Tool calls/results and opaque summaries are not imported.
+      if (typeof message.content === 'string') selected.push(message);
+      else if (Array.isArray(message.content)) {
+        const content = message.content.filter((part) => part?.type === 'text' && typeof part.text === 'string');
+        if (content.length) selected.push({ ...message, content });
+      }
+    }
+  }
+  return selected;
+}
