+        ...(phase === "frame_prepared" ? allowFrameDiagnostic(details, true) : {}),
+        ...(phase === "frame_rejected" ? allowFrameDiagnostic(details, false) : {}),
+      };
+      try { emit(record); } catch { /* Logging cannot alter admission or cancellation. */ }
+    };
+    return {
+      opened() {
+        if (closed || opened) return;
+        opened = true;
+        report("opened");
+      },
+      frameReceived() { if (!closed) frames++; },
+      framePrepared(fields) { if (!closed) report("frame_prepared", undefined, fields); },
+      frameRejected(fields) { if (!closed) report("frame_rejected", undefined, fields); },
+      frameSettled() { if (!closed) terminalFrames++; },
+      closed(reason, details) {
+        if (closed) return;
+        closed = true;
+        report("closed", reason, details);
+      },
+    };
+  };
+}
