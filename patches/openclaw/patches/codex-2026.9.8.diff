+
+/** Only a current host-created capsule can register an already retained source. */
+export function createQQNativeAttemptTrace(params, emit) {
+  return safe(() => {
+    const capsule = capsuleFor(params);
+    if (!capsule) return;
+    const began = clock();
+    const stages = Object.fromEntries([...NATIVE_STAGES].map(stage => [stage, null]));
