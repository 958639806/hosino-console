+    let closed = false, lastAcceptedTurnHash = null, firstTurnHash = null, nativeTurnAmbiguous = false, dispatchCount = 0, linkedTurns = 0;
+    const noteTurn = value => { if (firstTurnHash === null) firstTurnHash = value; else if (firstTurnHash !== value) nativeTurnAmbiguous = true; };
+    const report = record => safe(() => emit({ schema: 'qq-latency-trace-v1', layer: 'native', ...capsule, ...record }));
