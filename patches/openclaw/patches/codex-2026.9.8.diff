+const NATIVE_STAGES = new Set(['connection_ready', 'turn_dispatch', 'turn_accepted', 'native_first_text', 'native_terminal', 'model_call_done', 'trajectory_done']);
+// QQ-NATIVE-PREPARATION-SPANS v1. One summary per exact attempt; no authority.
+const PREPARATION_STAGES = Object.freeze(['connection', 'runtime', 'tools', 'context', 'prompt', 'runtime-start', 'thread-route', 'turn-request']);
+const PREPARATION_STAGE_SET = new Set(PREPARATION_STAGES);
