+
+const FRAME_OUTCOMES = new Set(['terminal', 'relay_busy', 'frame_forward_failure', 'overlapping_frame', 'frame_prepare_failure', 'authorization_denied', 'local_socket_close', 'local_socket_error', 'local_socket_end', 'local_websocket_close', 'local_websocket_error', 'upstream_close', 'upstream_error', 'proxy_shutdown', 'active_context_abort', 'active_frame_abort', 'idle_timeout', 'unclassified']);
