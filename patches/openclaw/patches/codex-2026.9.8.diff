--- a/dist/.setup/qq-native-auto-compact.mjs	1970-01-01 07:30:00.000000000 +0730
+++ b/dist/.setup/qq-native-auto-compact.mjs	2026-11-13 19:09:03.893012147 +0800
@@ -0,0 +1,65 @@
+// CODEX-LATENCY456-PATCH v1
+export const QQ_NATIVE_AUTO_COMPACT_TARGET = 131072;
+export const QQ_NATIVE_AUTO_COMPACT_KILL_SWITCH = 'OPENCLAW_QQ_EARLY_NATIVE_COMPACT';
+const TARGET_SESSIONS = new Set([
+  'agent:main:qqbot:group:__HS_GROUP_NEW_OPENID__',
+  'agent:main:qqbot:group:__HS_GROUP_OLD_OPENID__',
+]);
+const LIMIT = 'model_auto_compact_token_limit';
+const SCOPE = 'model_auto_compact_token_limit_scope';
+const VALID_SCOPES = new Set(['total', 'body_after_prefix']);
+const logged = new Set();
+const record = value => value !== null && typeof value === 'object' && !Array.isArray(value);
+const validLimit = value => typeof value === 'number' && Number.isSafeInteger(value) && value > 0;
+
+/** Retain only validity, integer threshold, and the known scope enum from an existing config/read. */
+export function captureCodexQQNativeCompactMetadata(snapshot) {
+  if (!record(snapshot?.config)) return Object.freeze({ read: false });
+  const config = snapshot.config;
+  const origins = record(snapshot.origins) ? snapshot.origins : {};
+  // config/read may serialize an unset Option as null; a sourced null remains explicit/invalid.
+  const present = key => Object.hasOwn(config, key) && config[key] !== undefined && (config[key] !== null || Object.hasOwn(origins, key));
+  const limitPresent = present(LIMIT);
+  const scopePresent = present(SCOPE);
+  const limitValid = limitPresent && validLimit(config[LIMIT]);
+  const scopeValid = scopePresent && VALID_SCOPES.has(config[SCOPE]);
+  return Object.freeze({
+    read: true, limitPresent, limitValid, ...(limitValid ? { limit: config[LIMIT] } : {}),
+    scopePresent, scopeValid, ...(scopeValid ? { scope: config[SCOPE] } : {}),
+  });
+}
+
+/** A request-only threshold override for the two authorized, host-owned QQ native sessions. */
+export function applyCodexQQNativeAutoCompactConfig(params, options, config, emit, env = process.env) {
+  const session = typeof params?.sessionKey === 'string' ? params.sessionKey.trim().toLowerCase() : '';
+  if (!TARGET_SESSIONS.has(session)) return config;
+  const group = session.split(':').at(-1).slice(0, 6);
+  const log = data => {
+    const safe = { group, ...data };
+    const key = JSON.stringify(safe);
+    if (logged.has(key)) return;
+    logged.add(key);
+    if (logged.size > 128) logged.clear();
+    try { emit?.(safe); } catch {}
+  };
+  const skip = reason => { log({ action: 'skipped', reason }); return config; };
+  const kill = String(env?.[QQ_NATIVE_AUTO_COMPACT_KILL_SWITCH] ?? '').trim().toLowerCase();
+  if (['0', 'off', 'false', 'no'].includes(kill)) return skip('kill-switch');
+  const appServer = options?.appServer;
+  if (appServer?.start?.transport !== 'stdio' || appServer?.connectionClass !== 'local-loopback' || appServer.start.homeScope === 'user') return skip('native-scope');
+  if (options?.preserveNativeModel === true || options?.preserveNativeTurnSettings === true || options?.usesSupervisionConnection === true || options?.connectionScope === 'supervision' || options?.binding?.connectionScope === 'supervision') return skip('native-owned-settings');
+  if (!record(config)) return skip('invalid-thread-config');
+  const native = options.qqNativeCompactMetadata;
+  if (native?.read !== true) return skip('native-metadata-missing');
+  const hasLimit = Object.hasOwn(config, LIMIT);
+  if (hasLimit && !validLimit(config[LIMIT])) return skip('invalid-explicit-limit');
+  if (native.limitPresent && !native.limitValid) return skip('invalid-native-limit');
+  const hasScope = Object.hasOwn(config, SCOPE);
+  if (hasScope && !VALID_SCOPES.has(config[SCOPE])) return skip('invalid-explicit-scope');
+  if (native.scopePresent && !native.scopeValid) return skip('invalid-native-scope');
+  const limit = Math.min(QQ_NATIVE_AUTO_COMPACT_TARGET, ...(hasLimit ? [config[LIMIT]] : []), ...(native.limitPresent ? [native.limit] : []));
+  log({ action: limit < QQ_NATIVE_AUTO_COMPACT_TARGET ? 'kept-lower' : 'applied', threshold: limit });
+  if (hasLimit && config[LIMIT] === limit) return config;
+  // Do not set scope, change model_context_window, or modify any history/tool/authority field.
+  return { ...config, [LIMIT]: limit };
+}
diff -ruN a/dist/.setup/qq-native-exec-lifecycle.mjs b/dist/.setup/qq-native-exec-lifecycle.mjs
--- a/dist/.setup/qq-native-exec-lifecycle.mjs	1970-01-01 07:30:00.000000000 +0730
+++ b/dist/.setup/qq-native-exec-lifecycle.mjs	2026-11-13 19:09:03.893012147 +0800
@@ -0,0 +1,42 @@
+// QQ-NATIVE-EXEC-LIFECYCLE-PATCH v1
+// Stable developer guidance only. This does not intercept or deduplicate commands.
+export const QQ_EXEC_LIFECYCLE_SESSION = 'agent:main:qqbot:group:__HS_GROUP_NEW_OPENID__';
+export const QQ_EXEC_LIFECYCLE_KILL_SWITCH = 'OPENCLAW_QQ_EXEC_LIFECYCLE';
+
+// The command is supplied by the task. Native tools and their permissions remain authoritative.
+// At most two polls avoid a model round trip for commands that finish shortly after first yield.
+export const QQ_EXEC_LIFECYCLE_EXAMPLE = `const chunks = [];
+let r = await tools.exec_command(commandArgs);
+text(r); chunks.push(typeof r.output === "string" ? r.output : "");
+for (let polls = 0; r.session_id !== undefined && r.exit_code === undefined && polls < 2; polls++) {
+  if (typeof tools.write_stdin !== "function") break;
+  try {
+    r = await tools.write_stdin({session_id:r.session_id, chars:"", yield_time_ms:10000});
+    text(r); chunks.push(typeof r.output === "string" ? r.output : "");
+  } catch (error) {
+    text({status:"unconfirmed", session_id:r.session_id, error:String(error)});
+    break;
+  }
+}
+const stdout = chunks.join("");`;
+
+const GUIDANCE = [
+  'Native shell task lifecycle (usage contract; does not authorize any task):',
+  'For tools.exec_command and tools.write_stdin inside exec JS, always emit the full result with text(r) or text(JSON.stringify(r)). Never emit only r.output and discard session_id/exit_code. The outer "Script completed" means the JavaScript cell finished; it does not mean the shell command exited. Empty output also does not mean failure.',
+  'A result with session_id and no exit_code is still running. Keep that exact handle; use tools.write_stdin only when it is provided, with that session_id and empty chars to poll. Do not run exec_command again to recover output, change printing, or wait for the same task. A numeric exit_code proves the process exited; use its actual value. Missing handle and exit_code, missing write_stdin, thrown errors, cancellation, or unknown outcome must be reported as unconfirmed; do not restart the command automatically.',
+  'If a command is expected to take tens of seconds, start it once and do up to two 10-second polls in the same exec JS, preserving every full result and accumulating output chunks before parsing script JSON or sending dependent media. If still running after those polls, return its full handle and continue later. If the outer exec itself returns a running cell ID, use its existing wait entry point; do not start a new exec to rerun the command. Errors or aborts never justify a second start. Respect native cancellation, tool availability, permissions, and the actual user request.',
+  'Example (commandArgs is the one already-authorized command; use stdout only after exit_code === 0):',
+  QQ_EXEC_LIFECYCLE_EXAMPLE,
+].join('\n');
+
+export function buildQQNativeExecLifecycleInstructions(params = {}, options = {}, env = process.env) {
+  const session = options.sessionKey ?? params.sessionKey;
+  if (session !== QQ_EXEC_LIFECYCLE_SESSION || options.nativeToolSurfaceEnabled !== true) return '';
+  if (params.disableTools === true || params.toolsAllow?.length === 0) return '';
+  if (options.usesSupervisionConnection === true || options.preserveNativeModel === true || options.connectionScope === 'supervision') return '';
+  const server = options.appServer;
+  if (server?.connectionClass !== 'local-loopback' || server?.start?.transport !== 'stdio' || server.start.homeScope === 'user') return '';
+  const kill = String(env?.[QQ_EXEC_LIFECYCLE_KILL_SWITCH] ?? '').trim().toLowerCase();
+  if (['0', 'off', 'false', 'no'].includes(kill)) return '';
+  return GUIDANCE;
+}
