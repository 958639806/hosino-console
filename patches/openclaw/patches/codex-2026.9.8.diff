+
+function isFullSkillPath(value) {
+  // OpenClaw's prompt formatter deliberately abbreviates the current home as ~/.
+  // Keep that exact source spelling, rather than expanding or shortening paths.
+  return /^(?:~\/|\/|[A-Za-z]:[\\/]|\\\\[^\\])/u.test(value) && /(?:^|[\\/])SKILL\.md$/u.test(value);
+}
+
+/** Strictly accept the host's known XML contract, or let the caller keep it. */
+export function parseOpenClawSkillCatalog(source) {
+  if (typeof source !== "string") throw new TypeError("skills-prompt-not-string");
+  const start = source.indexOf(OPEN);
+  const end = source.indexOf(CLOSE, start + OPEN.length);
+  if (start < 0 || end < 0 || source.indexOf(OPEN, start + OPEN.length) >= 0 || source.indexOf(CLOSE, end + CLOSE.length) >= 0) throw new Error("catalog-boundary-mismatch");
+  const body = source.slice(start + OPEN.length, end);
+  const entryPattern = /<skill>\s*<name>([\s\S]*?)<\/name>\s*<description>([\s\S]*?)<\/description>\s*<location>([\s\S]*?)<\/location>\s*<\/skill>/gu;
+  const entries = [];
+  const names = new Set();
+  const paths = new Set();
+  let cursor = 0;
+  for (const match of body.matchAll(entryPattern)) {
+    if (body.slice(cursor, match.index).trim()) throw new Error("unrecognized-catalog-content");
+    const name = decodeXmlText(match[1]);
+    const description = decodeXmlText(match[2]);
+    const location = decodeXmlText(match[3]);
+    if (!name.trim() || !description.trim() || !isFullSkillPath(location)) throw new Error("invalid-skill-field");
+    if (names.has(name) || paths.has(location)) throw new Error("ambiguous-skill-catalog");
+    names.add(name);
+    paths.add(location);
+    entries.push(Object.freeze({ name, description, location }));
+    cursor = match.index + match[0].length;
+  }
+  if (!entries.length || body.slice(cursor).trim()) throw new Error("unrecognized-catalog-content");
+  return Object.freeze({
+    prefix: source.slice(0, start),
+    suffix: source.slice(end + CLOSE.length),
+    entries: Object.freeze(entries)
+  });
+}
+
+function stringifyRow(entry) {
+  return JSON.stringify([entry.name, entry.description, entry.location])
+    .replace(/</gu, "\\u003c").replace(/>/gu, "\\u003e").replace(/&/gu, "\\u0026")
+    .replace(/\u2028/gu, "\\u2028").replace(/\u2029/gu, "\\u2029");
+}
+
+/**
+ * No description rewriting, ranking, filtering, path abbreviation, or clipping.
+ * A changed host format or malformed entry falls back to the original prompt.
+ */
+export function inspectCompactOpenClawSkillsPrompt(source) {
+  if (typeof source !== "string") return Object.freeze({ prompt: source, changed: false, reason: "skills-prompt-not-string", entryCount: null });
+  let parsed;
+  try {
+    parsed = parseOpenClawSkillCatalog(source);
+  } catch (error) {
+    return Object.freeze({ prompt: source, changed: false, reason: error instanceof Error ? error.message : "catalog-parse-failed", entryCount: null });
+  }
+  const catalog = [OPEN, `<!-- ${SKILL_CATALOG_FORMAT} -->`, INTRO, ...parsed.entries.map(stringifyRow), CLOSE].join("\n");
+  const prompt = parsed.prefix + catalog + parsed.suffix;
+  if (prompt.length >= source.length) return Object.freeze({ prompt: source, changed: false, reason: "not-smaller", entryCount: parsed.entries.length });
+  return Object.freeze({ prompt, changed: true, reason: "lossless-format-only", entryCount: parsed.entries.length });
+}
+
+export function compactOpenClawSkillsPrompt(source) {
+  return inspectCompactOpenClawSkillsPrompt(source).prompt;
+}
