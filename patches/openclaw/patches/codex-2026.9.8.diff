+
+function cleanBoundary(text, offset) {
+  return offset > 0 && offset < text.length && /[\uD800-\uDBFF]/.test(text[offset - 1]) && /[\uDC00-\uDFFF]/.test(text[offset]) ? offset - 1 : offset;
+}
+
+function statusProjection(result) {
+  const found = [];
+  let visited = 0;
+  function visit(value, trail, depth) {
+    if (!value || typeof value !== 'object') return;
+    if (depth > 5 || visited++ > 300) throw new Error('Execution metadata exceeds inspection bounds');
