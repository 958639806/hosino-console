+/**
+ * Native-prompt presentation only. The host's source skills snapshot, eligibility,
+ * order, instructions, files, and explicit-skill selection stay authoritative.
+ */
+export const SKILL_CATALOG_FORMAT = "openclaw-skill-catalog-jsonl-v1";
+
+const INTRO = "Catalog format: JSONL; each row is [name, description, full SKILL.md path]. Read the listed SKILL.md before using that skill.";
+const OPEN = "<available_skills>";
+const CLOSE = "</available_skills>";
+
+function decodeXmlText(value) {
+  if (/[<>]/u.test(value)) throw new Error("nested-field-markup");
+  let cursor = 0;
+  let decoded = "";
+  const entity = /&([^;]*);/gu;
+  for (const match of value.matchAll(entity)) {
+    const plain = value.slice(cursor, match.index);
+    if (plain.includes("&")) throw new Error("invalid-xml-entity");
+    decoded += plain;
+    const named = { amp: "&", lt: "<", gt: ">", quot: '"', apos: "'" };
+    if (Object.hasOwn(named, match[1])) decoded += named[match[1]];
+    else {
+      const numeric = /^(?:#([0-9]+)|#x([0-9a-fA-F]+))$/u.exec(match[1]);
+      if (!numeric) throw new Error("invalid-xml-entity");
+      const code = Number.parseInt(numeric[1] ?? numeric[2], numeric[1] ? 10 : 16);
+      if (!Number.isSafeInteger(code) || code <= 0 || code > 0x10ffff || code >= 0xd800 && code <= 0xdfff) throw new Error("invalid-xml-codepoint");
+      decoded += String.fromCodePoint(code);
+    }
+    cursor = match.index + match[0].length;
+  }
+  const tail = value.slice(cursor);
+  if (tail.includes("&")) throw new Error("invalid-xml-entity");
+  return decoded + tail;
