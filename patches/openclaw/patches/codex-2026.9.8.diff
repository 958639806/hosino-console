+    }
+  }
+  visit(result, 'result', 0);
+  for (let block = 0; block < (result.content?.length ?? 0); block += 1) {
+    const text = result.content[block].text;
+    const trimmed = text.trim();
+    let structured = false;
+    if (/^[\[{]/.test(trimmed) && /[\]}]$/.test(trimmed)) {
+      let payload;
+      try { payload = JSON.parse(trimmed); } catch {}
+      if (payload && typeof payload === 'object') { visit(payload, `content[${block}].json`, 0); structured = true; }
+    }
+    for (const line of structured ? [] : text.split('\n')) {
+      if (/\b(?:exit[ _-]?code|session[ _-]?id|process[ _-]?id|chunk[ _-]?id|tool[ _-]?call[ _-]?id|next[ _-]?cursor|process exited with|script running with)\b/i.test(line)) {
+        if (line.length > 500) throw new Error('Unbounded execution status line');
+        found.push([`content[${block}].statusLine`, line]);
+      }
+    }
+  }
+  const text = JSON.stringify(found);
+  if (text.length > 2000) throw new Error('Too much execution metadata');
+  return found;
+}
+
+export function createScopedToolResultArchive({ scope, root, previewChars = PREVIEW_CHARS, now = () => Date.now(), maxStoreBytes = MAX_STORE_BYTES, maxRecordBytes = MAX_RECORD_BYTES, maxScanEntries = MAX_SCAN_ENTRIES, authorize = () => true, onDiagnostic = () => {} } = {}) {
