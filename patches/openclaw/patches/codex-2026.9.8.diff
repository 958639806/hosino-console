+    // The state directory must exist; never create ancestors in a public workspace.
+    const parent = fs.lstatSync(path.dirname(rootDir));
+    if (!parent.isDirectory() || parent.isSymbolicLink()) throw new Error('Invalid state directory');
+    ensurePrivateDirectory(rootDir);
+    ensurePrivateDirectory(scopeDir);
+  }
+  function store(result, call) {
+    assertAuthorized();
+    ensureRoot();
+    const record = { version: 1, scope, createdAt: new Date(now()).toISOString(), retention: 'manual-no-expiry', tool: { name: call.toolName, callId: call.callId, threadId: call.threadId ?? null, turnId: call.turnId ?? null }, result };
