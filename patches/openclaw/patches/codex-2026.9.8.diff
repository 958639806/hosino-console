+  const scopeDir = path.join(rootDir, scopeKey);
+  const safePreview = Math.max(1000, Math.min(12000, Math.trunc(previewChars)));
+  function assertAuthorized() { if (authorize() !== true) throw new Error('Current archive scope is no longer authorized'); }
