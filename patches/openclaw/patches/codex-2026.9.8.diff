+}
+
+export function createArchiveForHookContext(context) {
+  const scope = resolveArchiveScope(context);
+  if (!scope) return;
+  const scopeJson = JSON.stringify(scope);
+  try {
+    return createScopedToolResultArchive({ scope, authorize: () => JSON.stringify(resolveArchiveScope(context)) === scopeJson, onDiagnostic: event => {
+      // Counts only. No tool text, handles, requester IDs or archive paths in logs.
+      try { context?.onArchiveDiagnostic?.(event); } catch {}
+    } });
+  } catch { return; }
+}
+
+export function attachArchiveReader(params, archive, projectTool, context = params.hookContext) {
+  if (!archive && !canAdvertiseReader(context)) return params;
+  const tool = archive?.readerTool ?? readerDescriptor(async () => { throw new Error('Original tool results require a verified current human QQ requester'); });
