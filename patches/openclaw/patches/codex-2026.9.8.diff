+    const flushPreparation = () => {
+      if (preparationEmitted || !preparationSpans.length || began === null) return;
+      preparationEmitted = true;
+      const spans = preparationSpans.map(span => ({ ...span }));
+      const first = Math.min(...spans.map(span => span.beganMonoMs));
+      const last = Math.max(...spans.map(span => span.endedMonoMs));
+      const complete = preparationDropped === 0 && spans.length === PREPARATION_STAGES.length && spans.every((span, index) =>
+        span.name === PREPARATION_STAGES[index] && span.outcome === 'completed' &&
+        (index === 0 || spans[index - 1].endedMonoMs <= span.beganMonoMs));
