+		const runtime = {
+			path: database.path,
+			instanceId: command.type === "placementTurns.recoverWorkspace" || command.type === "placementTurns.handoffRuntimeRefreshResult" ? command.input.gatewayInstanceId : "",
+			now: () => command.input.nowMs ?? Date.now(),
+			read: () => db,
