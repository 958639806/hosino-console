+  state.records = state.records.map(({ id, text }) => ({ id, text })); // Replay receipts need IDs/text, not permanent embeddings.
+  receipt.save(state);
+  return state.records.map((r) => ({ id: r.id, memory: r.text, metadata: { event: 'ADD' } }));
+}
