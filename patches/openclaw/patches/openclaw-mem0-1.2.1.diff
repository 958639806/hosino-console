+const digest = (value) => createHash('sha256').update(value).digest('hex');
+export function pointId(receiptKey, scope, text) {
+  const chars = digest(`${receiptKey}\0${scope}\0${text}`).slice(0, 32).split('');
+  chars[12] = '5'; chars[16] = ((parseInt(chars[16], 16) & 3) | 8).toString(16);
+  const s = chars.join(''); return `${s.slice(0, 8)}-${s.slice(8, 12)}-${s.slice(12, 16)}-${s.slice(16, 20)}-${s.slice(20)}`;
+}
+
+export async function bounded(promise, signal) {
+  if (!signal) return promise;
+  if (signal.aborted) throw signal.reason || new Error('MEMORY_CAPTURE_DEADLINE');
+  let handler;
+  try {
+    return await Promise.race([promise, new Promise((_, reject) => { handler = () => reject(signal.reason || new Error('MEMORY_CAPTURE_DEADLINE')); signal.addEventListener('abort', handler, { once: true }); })]);
+  } finally { if (handler) signal.removeEventListener('abort', handler); }
+}
+
+const scopeWriters = new Map();
+export async function writeReceiptMemory(memory, messages, metadata, receipt, { lemmatize = (text) => text } = {}) {
+  const key = metadata.oc_write_scope;
+  const previous = scopeWriters.get(key) || Promise.resolve();
+  const current = previous.catch(() => {}).then(() => { receipt.check(); return writeReceiptMemoryUnlocked(memory, messages, metadata, receipt, lemmatize); });
+  scopeWriters.set(key, current);
+  const cleanup = () => { if (scopeWriters.get(key) === current) scopeWriters.delete(key); };
+  current.then(cleanup, cleanup);
+  return await bounded(current, receipt.signal);
+}
+async function writeReceiptMemoryUnlocked(memory, messages, metadata, receipt, lemmatize) {
